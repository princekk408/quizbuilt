{
  "id": "./",
  "name": "QuizBuilt",
  "short_name": "QuizBuilt",
  "description": "Quizzes, live competitions, a shared question bank and student tools.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#06070D",
  "theme_color": "#06070D",
  "categories": ["education"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Compete", "url": "./#/qb2/compete", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Question bank", "url": "./#/qb2/bank", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Student hub", "url": "./#/qb2", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ]
}
